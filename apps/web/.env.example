# ─── Supabase — Grazing Cattle ───────────────────────────────────────────────
# Template only — NO real values. Copy to `.env.local` and fill in from your
# Supabase project (Settings → API and Settings → Database).
# `.env.local` is gitignored; this file is safe to commit.

# Public — safe in the browser (protected by Row-Level Security).
# Settings → API → Project URL and the `anon` / `public` key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Admin — SERVER-ONLY, bypasses RLS. Never prefix NEXT_PUBLIC_.
# Settings → API → `service_role` key (click Reveal).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for Drizzle.
# Settings → Database → Connection string. Direct (5432) for migrations.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
