{
  "name": "@grazingcattle/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../apps/web/.env.local -- drizzle-kit generate",
    "db:migrate":  "dotenv -e ../../apps/web/.env.local -- drizzle-kit migrate",
    "db:studio":   "dotenv -e ../../apps/web/.env.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@grazingcattle/game-types": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0"
  }
}
