# Dependencies
node_modules/

# pnpm
.pnpm-store/

# Next.js
.next/
out/

# Build output
dist/
build/
*.tsbuildinfo

# Env files — ignore everything except the committed placeholder template.
# The leading "!" un-ignores .env.example so the repo can document which
# keys are needed without ever committing real values.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Testing
coverage/

# Vercel
.vercel

# Claude Code local settings
.claude/settings.local.json
